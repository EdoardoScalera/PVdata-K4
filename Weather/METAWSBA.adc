int alrtech_to_email;
int alrtech_to_sms;
int alrtech_to_local;
int alrtech_to_com0;
int alrtech_list;
string err;
try
{
  if (initialized == 0)
  { 
    initialized = 1;
    invalidStatus = 2;
  string cname=compname();
   csv_to_ftp=spgetint(cname+":csv_to_ftp");
  csv_to_email=spgetint(cname+":csv_to_email");
  csv_to_socket=spgetint(cname+":csv_to_socket");
  csv_to_local=spgetint(cname+":csv_to_local");
  csv_to_com0=spgetint(cname+":csv_to_com0");
  table_to_ftp=spgetint(cname+":table_to_ftp");
  table_to_email=spgetint(cname+":table_to_email");
  table_to_socket=spgetint(cname+":table_to_socket");
  table_to_local=spgetint(cname+":table_to_local");
  table_to_com0=spgetint(cname+":table_to_com0");
  sms_to_ftp=spgetint(cname+":sms_to_ftp");
  sms_to_email=spgetint(cname+":sms_to_email");
  sms_to_socket=spgetint(cname+":sms_to_socket");
  sms_to_local=spgetint(cname+":sms_to_local"); 
  sms_to_com0=spgetint(cname+":sms_to_com0");
  sms_to_sms=spgetint(cname+":sms_to_sms"); 
  alrmet_to_socket=spgetint(cname+":alrmet_to_socket");
  alrmet_to_ftp=spgetint(cname+":alrmet_to_ftp"); 
  alrmet_to_email=spgetint(cname+":alrmet_to_email"); 
  alrmet_to_sms=spgetint(cname+":alrmet_to_sms"); 
  alrmet_to_local=spgetint(cname+":alrmet_to_local");
  alrmet_to_com0=spgetint(cname+":alrmet_to_com0");
  alrtech_to_socket=spgetint(cname+":alrtech_to_socket"); 
  alrtech_to_ftp=spgetint(cname+":alrtech_to_ftp"); 
  alrtech_to_email=spgetint(cname+":alrtech_to_email"); 
  alrtech_to_sms=spgetint(cname+":alrtech_to_sms"); 
  alrtech_to_local=spgetint(cname+":alrtech_to_local");
  alrtech_to_com0=spgetint(cname+":alrtech_to_com0");
  alrtech_list=spgetint(cname+":alrtech_list");
  }
  if(_flags & 0x00000100)
 {
  if(isvalid(CSV_REP))
  {
    ;
   if(csv_to_ftp != 0)
   {
    ;
    obs_out=CSV_REP;
    write obs_ftp;
   }
   if(csv_to_email != 0)
   {
    ;   
    obs_out=CSV_REP;
    write obs_email;
   }
   if(csv_to_socket != 0)
   { 
    ;   
    socket_out=CSV_REP;
    write socket_out;  
   }
   if(csv_to_local != 0)
   { 
    ;   
    local_out=CSV_REP;
    write local_out;  
   }
   if(csv_to_com0 != 0)
   { 
    ;   
    com0_out=CSV_REP;
    write com0_out;  
   }
   statusof CSV_REP=invalidStatus;
  }
  else if(isvalid(TABLE_REP))
  {
    ;
   if(table_to_ftp  != 0)
   {
    ;   
    obs_out=TABLE_REP;
    write obs_ftp;

#!Str 6 'string sErr;
int initialized;
int doScan;
int doTrig;
int alarmSt[12];
try
{
 ;
 ;
 ;
 if(doScan)
 {
  write Table;
  doTrig=0;
   failure_description="";
  int iAlarm;
  int iLast=strlen(sensor_status_in)/3;
  ;
  for(iAlarm=0; iAlarm <= iLast; iAlarm++)
  {
   string sensorSt;
   sensorSt=mid(sensor_status_in,iAlarm*3,2);
   if(strcmp(sensorSt,"00")==0 || strcmp(sensorSt,"99")==0)
   {
    if(alarmSt[iAlarm]==1) doTrig=1;
    alarmSt[iAlarm]=0; 
   }
   else
   {
    ;
    int wasChanged=0;
    if(alarmSt[iAlarm]==0) 
    {
     doTrig=1;
     wasChanged=1;
     alarmSt[iAlarm]=1;
    }
    if(iAlarm==0) 
    {
     failure_description=failure_description+TA_name;
     currAlarmMessage=TA_name;
    }
    else if(iAlarm==1) 
    {
     failure_description=failure_description+RH_name;  
     currAlarmMessage=RH_name;
    }
    else if(iAlarm==2) 
    {
     failure_description=failure_description+PA_name;
     currAlarmMessage=PA_name;
    }
    else if(iAlarm==3) 
    {
     failure_description=failure_description+WD_name;
     currAlarmMessage=WD_name;
    }
    else if(iAlarm==4)
    {
     failure_description=failure_description+WS_name;
     currAlarmMessage=WS_name;
    }
    else if(iAlarm==5)
    {
     failure_description=failure_description+PR_name;
     currAlarmMessage=PR_name;
    }
    else if(iAlarm==6)
    {
     failure_description=failure_description+SR_name;
     currAlarmMessage=SR_name;
    }
    else if(iAlarm==7)
    {
     failure_description=failure_description+ST1_name;
     currAlarmMessage=ST1_name;
    }
    else if(iAlarm==8)
    {
     failure_description=failure_description+ST2_name;
     currAlarmMessage=ST2_name;
    }
      else if(iAlarm==9)
    {
     failure_description=failure_description+SH_name;
     currAlarmMessage=SH_name;
    }
    else if(iAlarm==10)
    {
     wasChanged=0;
    }
    else if(iAlarm==11) 
    {
     wasChanged=0;
    }
    failure_description=failure_description+"\r\n";
    if(wasChanged) write TechAlarmMessage;
   }
  }
  if(strlen(failure_description)==0) failure_description="No technical alarms";
  if(doTrig) 
  {
   write SensorAlarmMessage;
  }
 }
 else if(initialized==0)
 {
  read start_delay;
  if(isvalid(start_delay)==0) start_delay=120;
  if(start_delay > 0) 
  {
   createtimer(start_delay,0x10000000); 
   ;
  }
  else doScan=1;
  initialized=1;
 }
 else if(_flags & 0x10000000)
 {
  ;
  doScan=1;
 }
}
catch
{
 sErr="Unhandled exception";
 warning(sErr);
 ;
}

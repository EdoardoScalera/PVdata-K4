#!Str 10 'int gotmeasure;
int initialized;
try
{
 if(initialized==0)
 {
  read WA15;
  if(isvalid(WA15)==1) initialized=1;
  else warning("Wind sensor setting missing, parameter WA15"); 
  read timeout; 
  int htev=createtimer(0,1,timeout,timeout,0x800);
 }
 else
 {
  if(_flags & 0x100)
  {
   if(WA15)
   { 
    if(isvalid(meas_in_WA15))
    {
      meas_out=meas_in_WA15;
     write meas_out;
     statusof meas_in_WA15=2;
     gotmeasure=1;
    }
   }
   else
   {
    if(isvalid(meas_in_WMT700)) 
    {
     meas_out=meas_in_WMT700;
     write meas_out;
     statusof meas_in_WMT700=2;
     gotmeasure=1;
    }
   }  
  }
  else if(_flags & 0x800)
  {
   if(gotmeasure==0)
   {
    statusof meas_out=2;
    write meas_out;
   } 
   gotmeasure=0;
   if(WA15)
   {
    sensorstout=99;
   }
   else
   {
    read sensorst;
    sensorstout=sensorst;
   }
  }
 }
}
catch
{
 string sErr="Unhandled exception";
 warning(sErr);
 ;
}

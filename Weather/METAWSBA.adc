#!Str 3 'read speedup;
if(isvalid(speedup))
{
 if(speedup > 0 && speedup <= 8)
 {
  int time=utctime(-1);
  int offset=9-(time % 10);
  if(offset > 1)
  {
   if(offset > speedup) offset=speedup;
   ;
   time=utctime(time+offset);
  }
  else ;
 }
}
'
#!Str 4 'int initialized;
int invalidStatus;
int csv_to_ftp;
int csv_to_email;
int csv_to_socket;
int csv_to_local;
int csv_to_com0;
int table_to_ftp;
int table_to_email;
